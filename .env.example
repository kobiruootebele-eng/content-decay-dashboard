# Path to your OAuth2 credentials JSON downloaded from Google Cloud Console
# Default: credentials.json (in the project root)
CREDENTIALS_PATH=credentials.json

# Your Google Search Console property URL.
# Use the EXACT format shown in GSC — one of:
#   sc-domain:example.com          (Domain property)
#   https://example.com/           (URL-prefix property — note trailing slash)
GSC_PROPERTY_URL=sc-domain:example.com
